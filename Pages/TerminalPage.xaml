<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AiAgent.Pages.TerminalPage"
             Title="Terminal"
             BackgroundColor="#0F0F12">
    <Grid RowDefinitions="*,Auto" Padding="12">
        <ScrollView Grid.Row="0">
            <Label x:Name="Output" Text="Ginger Terminal — sandboxed.&#10;Commands run in-app only; no shell escape." TextColor="#AAA" FontFamily="Courier" FontSize="12" LineBreakMode="WordWrap"/>
        </ScrollView>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,0">
            <Entry x:Name="CmdEntry" Placeholder="echo hello" TextColor="White" PlaceholderColor="#555" BackgroundColor="#1A1A20" Completed="OnRun"/>
            <Button Grid.Column="1" Text="Run" Clicked="OnRun" BackgroundColor="#6C4DFF" TextColor="White" CornerRadius="10"/>
        </Grid>
    </Grid>
</ContentPage>

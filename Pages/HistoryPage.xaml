<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AiAgent.Pages.HistoryPage"
             Title="History"
             BackgroundColor="#0F0F12">
    <Grid RowDefinitions="Auto,*" Padding="12">
        <Button Grid.Row="0" Text="Clear all" Clicked="OnClear" BackgroundColor="#2A2A33" TextColor="White" CornerRadius="10" HorizontalOptions="End"/>
        <CollectionView x:Name="List" Grid.Row="1" SelectionMode="None" Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,6" BackgroundColor="#1A1A20" Stroke="#2D2D36" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                            <Label Text="{Binding UpdatedAt, StringFormat='{0:g}'}" TextColor="#888" FontSize="11"/>
                            <Label Text="{Binding Messages.Count, StringFormat='{0} messages'}" TextColor="#666" FontSize="11"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No conversations yet." TextColor="#666" HorizontalOptions="Center" Margin="0,40,0,0"/>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
